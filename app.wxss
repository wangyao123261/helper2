
page {
  background: #f5f7fa;
  color: #1f2937;
  font-size: 32rpx;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", "Microsoft YaHei", sans-serif;
  height: 100%;
}

.screen {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f5f7fa;
  box-sizing: border-box;
}

.screen.has-tab {
  padding-bottom: calc(112rpx + env(safe-area-inset-bottom));
}

.body {
  flex: 1;
  height: 0;
  box-sizing: border-box;
}

.pad {
  padding: 28rpx 32rpx 24rpx;
}

.card {
  background: #fff;
  border: 1rpx solid #e9edf3;
  border-radius: 28rpx;
  box-sizing: border-box;
}

.row {
  display: flex;
  align-items: center;
}

.between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.tag {
  display: inline-flex;
  align-items: center;
  padding: 2rpx 16rpx;
  border-radius: 8rpx;
  font-size: 26rpx;
  font-weight: 500;
  line-height: 36rpx;
  max-width: 100%;
  box-sizing: border-box;
}

.tag-blue {
  background: rgba(22, 93, 255, 0.1);
  color: #165dff;
}

.tag-green {
  background: rgba(0, 180, 42, 0.1);
  color: #00b42a;
}

.tag-red {
  background: rgba(245, 63, 63, 0.08);
  color: #f53f3f;
}

.tag-orange {
  background: rgba(245, 158, 11, 0.12);
  color: #d97706;
}

.tag-gray {
  background: #f5f7fa;
  color: #6b7280;
}

.chip {
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  border: 1rpx solid #e5e7eb;
  background: #fff;
  color: #6b7280;
  line-height: 32rpx;
}

.chip.active {
  background: rgba(22, 93, 255, 0.1);
  border-color: #165dff;
  color: #165dff;
  font-weight: 500;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.f-label {
  display: block;
  font-size: 28rpx;
  color: #6b7280;
  margin-bottom: 8rpx;
}

.req {
  color: #f53f3f;
  margin-left: 4rpx;
}

.f-input {
  width: 100%;
  border: 1rpx solid #e5e7eb;
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  font-size: 32rpx;
  background: #fff;
  box-sizing: border-box;
  color: #1f2937;
  min-height: 72rpx;
  line-height: 40rpx;
}

.f-input.err {
  border-color: #f53f3f;
}

.placeholder {
  color: #9ca3af;
}

.muted {
  color: #9ca3af;
}

.progress {
  flex: 1;
  height: 12rpx;
  border-radius: 6rpx;
  background: #eef1f6;
  overflow: hidden;
}

.progress-in {
  height: 100%;
  border-radius: 6rpx;
  background: #165dff;
}

.progress-in.red {
  background: #f53f3f;
}

.sec-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #374151;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.dot-blue,
.dot-red {
  width: 12rpx;
  height: 12rpx;
  border-radius: 4rpx;
}

.dot-blue {
  background: #165dff;
}

.dot-red {
  background: #f53f3f;
}

.empty {
  text-align: center;
  color: #9ca3af;
  font-size: 30rpx;
  padding: 80rpx 0;
}

.empty-ico {
  display: block;
  font-size: 56rpx;
  color: #d1d5db;
  margin-bottom: 16rpx;
}

.btn {
  border-radius: 24rpx;
  font-size: 30rpx;
  font-weight: 500;
  line-height: 80rpx;
  text-align: center;
  border: none;
  padding: 0;
  margin: 0;
}

.btn::after {
  border: none;
}

.btn-primary {
  background: #165dff;
  color: #fff;
}

.btn-ghost {
  background: #fff;
  color: #165dff;
  border: 1rpx solid rgba(22, 93, 255, 0.4);
}

.btn-line {
  background: #fff;
  color: #4b5563;
  border: 1rpx solid #d1d5db;
}

.btn-green {
  background: #00b42a;
  color: #fff;
}

.btn-orange {
  background: #d97706;
  color: #fff;
}

.meta {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx 24rpx;
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #6b7280;
}

.name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2937;
  line-height: 1.4;
  flex: 1;
  min-width: 0;
}

.link {
  color: #165dff;
  font-size: 26rpx;
}

.foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f3f4f6;
  font-size: 26rpx;
  color: #9ca3af;
}

.dock {
  padding: 12rpx 32rpx 20rpx;
  background: #f5f7fa;
}

.footer-bar {
  background: #fff;
  border-top: 1rpx solid #e5e7eb;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  display: flex;
  gap: 16rpx;
}

.footer-bar .btn {
  flex: 1;
  font-size: 28rpx;
  line-height: 76rpx;
}

.search-wrap {
  position: relative;
  margin-bottom: 16rpx;
}

.search-ico {
  position: absolute;
  left: 20rpx;
  top: 50%;
  transform: translateY(-50%);
  color: #9ca3af;
  font-size: 28rpx;
}

.search-input {
  padding-left: 64rpx;
  background: #fff;
}

.kv {
  display: flex;
  gap: 16rpx;
  font-size: 28rpx;
  line-height: 1.6;
  margin-top: 12rpx;
}

.kv .k {
  width: 208rpx;
  flex-shrink: 0;
  color: #9ca3af;
}

.kv .v {
  flex: 1;
  color: #374151;
  min-width: 0;
  word-break: break-all;
}

.badge-no {
  width: 32rpx;
  height: 32rpx;
  border-radius: 8rpx;
  background: #165dff;
  color: #fff;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.grid-2 {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.grid-3 {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 16rpx;
}

.mt {
  margin-top: 20rpx;
}

.mb {
  margin-bottom: 20rpx;
}

.gap-list > view + view,
.stack > view + view {
  margin-top: 20rpx;
}
