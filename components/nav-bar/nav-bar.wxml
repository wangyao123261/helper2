<view class="brand" style="padding-top: {{statusBarHeight}}px;">
  <view class="brand-inner">
    <view class="logo iconfont icon-huoche"></view>
    <view class="brand-text">
      <view class="brand-title">清洁运输监督帮扶</view>
      <view class="brand-sub">机动车中心</view>
    </view>
    <!-- <view class="bell" bindtap="onBell">
      <view class="bell-dot"></view>
    </view> -->
  </view>
</view>
<view class="subnav" wx:if="{{mode !== 'brand'}}">
  <view class="sub-inner">
    <view class="side" bindtap="onBack">
      <view class="back"></view>
    </view>
    <view class="sub-title">{{title}}</view>
    <view class="side right">
      <slot name="right"></slot>
      <text wx:if="{{extra}}" class="extra" bindtap="onExtra">{{extra}}</text>
    </view>
  </view>
</view>
