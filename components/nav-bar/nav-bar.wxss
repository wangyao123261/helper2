@import "../../styles/iconfont.wxss";
.brand {
  background: linear-gradient(90deg, #165dff, #4080ff);
  color: #fff;
  flex-shrink: 0;
}

.brand-inner {
  height: 112rpx;
  padding: 0 32rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.logo {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.22);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 700;
}

.brand-text {
  flex: 1;
  min-width: 0;
}

.brand-title {
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.2;
}

.brand-sub {
  margin-top: 4rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.75);
}

.bell {
  width: 36rpx;
  height: 36rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 18rpx 18rpx 16rpx 16rpx;
  position: relative;
}

.bell::after {
  content: "";
  position: absolute;
  left: 12rpx;
  bottom: -8rpx;
  width: 8rpx;
  height: 8rpx;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 4rpx;
}

.bell-dot {
  position: absolute;
  top: -4rpx;
  right: -4rpx;
  width: 12rpx;
  height: 12rpx;
  background: #f87171;
  border-radius: 50%;
}

.subnav {
  background: #fff;
  border-bottom: 1rpx solid #e5e7eb;
  flex-shrink: 0;
}

.sub-inner {
  height: 88rpx;
  display: flex;
  align-items: center;
  padding: 0 12rpx;
}

.side {
  width: 168rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  padding-left: 12rpx;
  box-sizing: border-box;
}

.side.right {
  justify-content: flex-end;
  padding-right: 12rpx;
  padding-left: 0;
  gap: 16rpx;
}

.back {
  width: 18rpx;
  height: 18rpx;
  border-left: 4rpx solid #4b5563;
  border-bottom: 4rpx solid #4b5563;
  transform: rotate(45deg);
  margin-left: 8rpx;
}

.sub-title {
  flex: 1;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2937;
}

.extra {
  color: #165dff;
  font-size: 30rpx;
}
