@import "../styles/iconfont.wxss";
.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 99;
  display: flex;
  background: #fff;
  border-top: 1rpx solid #eef0f4;
  padding-bottom: env(safe-area-inset-bottom);
}

.tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  height: 100rpx;
  color: #9ca3af;
  font-size: 26rpx;
}

.tab.active {
  color: #165dff;
}

.ico {
  width: 36rpx;
  height: 36rpx;
  position: relative;
  box-sizing: border-box;
}



