.form-pad { padding-bottom: 32rpx; }
.block { padding: 28rpx; }
.arrow { color: #d1d5db; font-size: 32rpx; }
.area { min-height: 120rpx; width: 100%; }
.etype-err { outline: 4rpx solid rgba(245, 63, 63, 0.35); border-radius: 16rpx; }
.problem {
  margin-top: 20rpx;
  padding: 24rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: 24rpx;
  background: rgba(249, 250, 251, 0.7);
}
.p-title { font-size: 22rpx; font-weight: 600; color: #4b5563; }
.del { font-size: 22rpx; color: #f53f3f; }
.mt-sm { margin-top: 16rpx; }
.upload {
  margin-top: 16rpx;
  border: 1rpx dashed #c3cbd7;
  border-radius: 16rpx;
  text-align: center;
  color: #6b7280;
  font-size: 22rpx;
  line-height: 72rpx;
  background: #fff;
}
.photos { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 16rpx; }
.shot {
  width: 112rpx;
  height: 112rpx;
  position: relative;
  border-radius: 16rpx;
  overflow: hidden;
  background: #e5e7eb;
}
.shot image, .shot-ph { width: 100%; height: 100%; }
.shot-ph {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18rpx;
  color: #6b7280;
}
.shot-x {
  position: absolute;
  top: 0;
  right: 0;
  width: 32rpx;
  height: 32rpx;
  background: rgba(17, 24, 39, 0.75);
  color: #fff;
  font-size: 22rpx;
  text-align: center;
  line-height: 32rpx;
  border-radius: 0 0 0 12rpx;
}
.hint { text-align: center; color: #9ca3af; font-size: 22rpx; padding: 16rpx 0; }
