<view class="screen has-tab">
  <nav-bar mode="brand" />
  <scroll-view class="body" scroll-y>
    <view class="pad stack">
      <view class="between">
        <view>
          <view class="hello">您好，{{name}}</view>
          <view class="hello-sub">欢迎回到清洁运输监督帮扶平台</view>
        </view>
        <text class="tag tag-blue">{{dateChip}}</text>
      </view>

      <view class="grid-2">
        <view class="btn btn-primary" bindtap="goAdd">＋ 新增督查记录</view>
        <view class="btn btn-ghost" bindtap="goToday">今日工作日志</view>
      </view>

      <view class="grid-2">
        <view class="card stat" bindtap="goRecords">
          <view class="stat-ico blue">记</view>
          <view>
            <view class="stat-num">{{stats.records}}</view>
            <view class="stat-label">督查记录</view>
          </view>
        </view>
        <view class="card stat" bindtap="goCompanies">
          <view class="stat-ico green">企</view>
          <view>
            <view class="stat-num">{{stats.companies}}</view>
            <view class="stat-label">督查企业</view>
          </view>
        </view>
        <view class="card stat" bindtap="goLogs">
          <view class="stat-ico orange">志</view>
          <view>
            <view class="stat-num">{{stats.logs}}</view>
            <view class="stat-label">工作日志</view>
          </view>
        </view>
        <view class="card stat" bindtap="goProblems">
          <view class="stat-ico red">问</view>
          <view>
            <view class="stat-num">{{stats.problems}}</view>
            <view class="stat-label">发现问题</view>
          </view>
        </view>
      </view>

      <view class="card block">
        <view class="sec-title"><view class="dot-blue"></view>企业类型分布</view>
        <view class="bar-row" wx:for="{{etypeBars}}" wx:key="t">
          <text class="bar-label short">{{item.t}}</text>
          <view class="progress"><view class="progress-in" style="width: {{item.width}};"></view></view>
          <text class="bar-num">{{item.n}}</text>
        </view>
      </view>

      <view class="card block">
        <view class="sec-title"><view class="dot-red"></view>问题类型分布</view>
        <view class="bar-row" wx:for="{{problemBars}}" wx:key="c">
          <text class="bar-label">{{item.t}}</text>
          <view class="progress"><view class="progress-in red" style="width: {{item.width}};"></view></view>
          <text class="bar-num">{{item.n}}</text>
        </view>
      </view>

      <view class="card block">
        <view class="between mb">
          <view class="sec-title">最新督查记录</view>
          <text class="link" bindtap="goRecords">查看全部 ›</text>
        </view>
        <view class="recent" wx:for="{{recent}}" wx:key="id" data-id="{{item.id}}" bindtap="openRecord">
          <view class="row">
            <view class="avatar">{{item.initial}}</view>
            <view class="recent-main">
              <view class="recent-name">{{item.company}}</view>
              <view class="recent-sub">{{item.province}} {{item.city}} · {{item.industry}}</view>
            </view>
          </view>
          <view class="mt-sm"><text class="tag {{item.problemTag}}">{{item.problemText}}</text></view>
        </view>
      </view>
    </view>
  </scroll-view>
</view>
