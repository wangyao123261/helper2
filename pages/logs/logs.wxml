<view class="screen has-tab">
  <nav-bar mode="brand" />
  <view class="filter-box">
    <view class="search-wrap">

      <text class="search-ico iconfont icon-search"></text>

      <input class="f-input search-input" placeholder="搜索日期或企业名称" placeholder-class="placeholder" value="{{keyword}}" bindinput="onSearch" />
    </view>
  </view>
  <scroll-view class="body" scroll-y>
    <view class="pad stack" wx:if="{{list.length}}">
      <view class="card log" wx:for="{{list}}" wx:key="id">
        <view class="log-main" data-id="{{item.id}}" bindtap="openLog">
          <view class="between">
            <view class="log-date">{{item.dateText}}</view>
            <text class="tag tag-blue">督查 {{item.count}} 家</text>
          </view>
          <view class="summary">{{item.summary}}</view>
          <view class="chips mt-sm">
            <text class="tag tag-gray" wx:for="{{item.companies}}" wx:for-item="name" wx:key="*this">{{name}}</text>
          </view>
        </view>
        <view class="actions">
          <view class="act" data-id="{{item.id}}" bindtap="openLog"><text class="iconfont icon-chakan action-icon"></text>查看详情</view>
          <view class="act" data-kind="word" data-date="{{item.date}}" catchtap="exportFile"><text class="iconfont icon-file-word-fill action-icon"></text>导出Word</view>
          <view class="act orange" data-kind="ppt" data-date="{{item.date}}" catchtap="exportFile"><text class="iconfont icon-file-ppt-fill action-icon"></text>导出PPT</view>
        </view>
      </view>
    </view>
    <view class="empty" wx:else>
      <text class="empty-ico">空</text>
      未找到匹配的工作日志
    </view>
  </scroll-view>
</view>
