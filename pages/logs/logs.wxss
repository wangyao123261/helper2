.filter-box {
  padding: 24rpx 32rpx 0;
}

.log {
  overflow: hidden;
}

.log-main {
  padding: 28rpx 28rpx 20rpx;
}

.log-date {
  font-size: 26rpx;
  font-weight: 600;
}

.summary {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #6b7280;
  line-height: 1.7;
}

.mt-sm { margin-top: 16rpx; }

.actions {
  display: flex;
  border-top: 1rpx solid #f3f4f6;
}

.act {
  flex: 1;
  text-align: center;
  font-size: 22rpx;
  color: #165dff;
  line-height: 80rpx;
  border-left: 1rpx solid #f3f4f6;
}

.act:first-child {
  border-left: none;
}

.act.orange {
  color: #d97706;
}
