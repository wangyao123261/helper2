<view class="screen">
  <nav-bar mode="sub" title="修改密码" />
  <view class="pad">
    <view class="card block">
      <text class="f-label">原密码</text>
      <input class="f-input" password placeholder="演示默认密码 123456" placeholder-class="placeholder" value="{{oldPwd}}" bindinput="onOld" />
      <text class="f-label mt">新密码</text>
      <input class="f-input" password placeholder="8-20 位，含字母和数字" placeholder-class="placeholder" value="{{newPwd}}" bindinput="onNew" />
      <text class="f-label mt">确认新密码</text>
      <input class="f-input" password placeholder="再次输入新密码" placeholder-class="placeholder" value="{{confirmPwd}}" bindinput="onConfirm" />
      <view class="btn btn-primary mt-lg" bindtap="save">确认修改</view>
    </view>
  </view>
</view>
