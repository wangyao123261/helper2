.hero {
  padding: 32rpx;
  background: linear-gradient(135deg, #165dff, #4080ff);
  color: #fff;
  border: none;
}

.avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 42rpx;
  font-weight: 700;
  margin-right: 24rpx;
}

.hero-name {
  font-size: 34rpx;
  font-weight: 700;
}

.hero-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 12rpx;
}

.pill {
  background: rgba(255, 255, 255, 0.2);
  color: #fff;
  font-size: 26rpx;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
}

.hero-stats {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-top: 28rpx;
}

.hero-stat {
  background: rgba(255, 255, 255, 0.12);
  border-radius: 16rpx;
  text-align: center;
  padding: 16rpx 0;
}

.hero-num {
  font-size: 34rpx;
  font-weight: 700;
}

.hero-label {
  margin-top: 6rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.75);
}

.menu-item {
  padding: 28rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid #f3f4f6;
  font-size: 32rpx;
  color: #374151;
}

.menu-item:last-child {
  border-bottom: none;
}

.arrow {
  color: #d1d5db;
  font-size: 34rpx;
}

.logout {
  justify-content: center;
  color: #f53f3f;
  font-weight: 500;
}

.ver {
  text-align: center;
  color: #d1d5db;
  font-size: 26rpx;
}
