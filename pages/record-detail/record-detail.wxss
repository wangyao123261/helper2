@import "../../styles/iconfont.wxss";
.block { padding: 32rpx; }
.section-icon { font-size: 30rpx; }
.truck-icon { color: #165dff; }
.alert-icon { color: #f53f3f; }
.title { font-size: 32rpx; font-weight: 700; }
.sub { margin-top: 8rpx; font-size: 26rpx; color: #9ca3af; }
.ratio { display: flex; align-items: center; gap: 16rpx; }
.ratio-num { color: #165dff; font-weight: 600; flex-shrink: 0; }
.issue { margin-top: 24rpx; padding-left: 16rpx; border-left: 4rpx solid #fca5a5; }
.issue-cat { font-size: 28rpx; font-weight: 600; color: #f53f3f; }
.issue-sub { margin-top: 8rpx; font-size: 28rpx; color: #374151; }
.issue-desc { margin-top: 8rpx; font-size: 28rpx; color: #6b7280; line-height: 1.7; }
.ok { margin-top: 20rpx; font-size: 28rpx; color: #00b42a; }
